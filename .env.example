# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase.
# Encontre em: Supabase → seu projeto → Settings → API
# NÃO use a senha da conta nem a senha do banco aqui — apenas estes dois valores:

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon_public
